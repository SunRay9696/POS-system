# Optional: use a unique PIN before any shared deployment. Demo defaults to 2468.
STAFF_PIN=change-this-pin
# Local only by default; do not expose publicly without production hardening.
HOST=127.0.0.1
PORT=3000
# Optional real AI commentary. Reports continue to work without it.
# SQUAREBOX_AI_API_KEY=
# SQUAREBOX_AI_MODEL=gpt-4.1-mini
# Persistent database defaults to ./data/squarebox.sqlite
# DATABASE_PATH=./data/squarebox.sqlite

# Set only after hosting behind a configured HTTPS reverse proxy.
# PUBLIC_BASE_URL=https://your-restaurant.example
# COOKIE_SECURE=true
